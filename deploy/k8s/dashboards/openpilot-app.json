{
  "uid": "openpilot-backend-app",
  "title": "Openpilot Backend - App & Storage",
  "tags": ["openpilot", "application", "postgres"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": { "query": "label_values(athena_connected_devices, namespace)", "refId": "StandardVariableQuery" },
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Athena Connected Devices",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 } },
      "targets": [
        {
          "expr": "sum(athena_connected_devices{namespace=~\"$namespace\"})",
          "legendFormat": "Online"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active Uploads",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 } },
      "targets": [
        {
          "expr": "sum(active_uploads{namespace=~\"$namespace\"})",
          "legendFormat": "Uploads"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active Upload Bytes",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "expr": "sum(active_upload_bytes{namespace=~\"$namespace\"})",
          "legendFormat": "Bytes"
        }
      ]
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "MiniKeyValue PVC Usage",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "100 * kubelet_volume_stats_used_bytes{namespace=~\"$namespace\", persistentvolumeclaim=~\"kvstore-.*\"} / kubelet_volume_stats_capacity_bytes{namespace=~\"$namespace\", persistentvolumeclaim=~\"kvstore-.*\"}",
          "legendFormat": "{{persistentvolumeclaim}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Athena Connected Devices Over Time",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 } },
      "targets": [
        {
          "expr": "sum(athena_connected_devices{namespace=~\"$namespace\"})",
          "legendFormat": "Connected Devices"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "PVC Storage Used",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "expr": "kubelet_volume_stats_used_bytes{namespace=~\"$namespace\"}",
          "legendFormat": "{{persistentvolumeclaim}} used"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Background Worker Jobs (rate by status)",
      "gridPos": { "x": 0, "y": 11, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        {
          "expr": "sum by (worker, status) (rate(worker_jobs_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{worker}} ({{status}})"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Background Worker Duration (p95)",
      "gridPos": { "x": 12, "y": 11, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, worker) (rate(worker_job_duration_seconds_bucket{namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "{{worker}} p95"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "PostgreSQL Connections",
      "gridPos": { "x": 0, "y": 18, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 } },
      "targets": [
        {
          "expr": "sum by (state) (cnpg_backends_total{namespace=~\"$namespace\"}) or sum by (state) (pg_stat_activity_count{namespace=~\"$namespace\"})",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "PostgreSQL Transactions/s",
      "gridPos": { "x": 8, "y": 18, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        {
          "expr": "sum(rate(cnpg_pg_stat_database_xact_commit{namespace=~\"$namespace\"}[$__rate_interval])) or sum(rate(pg_stat_database_xact_commit{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "commits/s"
        },
        {
          "expr": "sum(rate(cnpg_pg_stat_database_xact_rollback{namespace=~\"$namespace\"}[$__rate_interval])) or sum(rate(pg_stat_database_xact_rollback{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "rollbacks/s"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "PostgreSQL Cache Hit Ratio",
      "gridPos": { "x": 16, "y": 18, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "targets": [
        {
          "expr": "(100 * sum(rate(cnpg_pg_stat_database_blks_hit{namespace=~\"$namespace\"}[$__rate_interval])) / clamp_min(sum(rate(cnpg_pg_stat_database_blks_hit{namespace=~\"$namespace\"}[$__rate_interval]) + rate(cnpg_pg_stat_database_blks_read{namespace=~\"$namespace\"}[$__rate_interval])), 1e-9)) or (100 * sum(rate(pg_stat_database_blks_hit{namespace=~\"$namespace\"}[$__rate_interval])) / clamp_min(sum(rate(pg_stat_database_blks_hit{namespace=~\"$namespace\"}[$__rate_interval]) + rate(pg_stat_database_blks_read{namespace=~\"$namespace\"}[$__rate_interval])), 1e-9))",
          "legendFormat": "Cache Hit %"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "PostgreSQL Database Size",
      "gridPos": { "x": 0, "y": 25, "w": 24, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "expr": "cnpg_pg_database_size_bytes{namespace=~\"$namespace\", datname!~\"template.*|postgres\"} or pg_database_size_bytes{namespace=~\"$namespace\", datname!~\"template.*|postgres\"}",
          "legendFormat": "{{datname}}"
        }
      ]
    }
  ]
}
