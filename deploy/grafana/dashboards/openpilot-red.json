{
  "uid": "openpilot-backend-red",
  "title": "Openpilot Backend - RED",
  "tags": ["openpilot", "red", "http"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": { "query": "label_values(http_requests_total, namespace)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "path",
        "label": "Route",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": { "query": "label_values(http_requests_total{namespace=\"$namespace\"}, path)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Request Rate",
      "gridPos": { "x": 0, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{namespace=\"$namespace\", path=~\"$path\"}[$__rate_interval]))",
          "legendFormat": "RPS"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "5xx Error Rate",
      "gridPos": { "x": 5, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "100 * (sum(rate(http_requests_total{namespace=\"$namespace\", path=~\"$path\", status=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(http_requests_total{namespace=\"$namespace\", path=~\"$path\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "5xx %"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "4xx Rate",
      "gridPos": { "x": 10, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{namespace=\"$namespace\", path=~\"$path\", status=~\"4..\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "4xx/s"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "In-Flight Requests",
      "gridPos": { "x": 14, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 } },
      "targets": [
        {
          "expr": "sum(http_requests_in_flight{namespace=\"$namespace\"})",
          "legendFormat": "In-flight"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Latency p95",
      "gridPos": { "x": 19, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\", path=~\"$path\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Request Rate by Status Class",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{namespace=\"$namespace\", path=~\"$path\", status=~\"2..\"}[$__rate_interval]))",
          "legendFormat": "2xx"
        },
        {
          "expr": "sum(rate(http_requests_total{namespace=\"$namespace\", path=~\"$path\", status=~\"3..\"}[$__rate_interval]))",
          "legendFormat": "3xx"
        },
        {
          "expr": "sum(rate(http_requests_total{namespace=\"$namespace\", path=~\"$path\", status=~\"4..\"}[$__rate_interval]))",
          "legendFormat": "4xx"
        },
        {
          "expr": "sum(rate(http_requests_total{namespace=\"$namespace\", path=~\"$path\", status=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Error Rate by Route (4xx & 5xx)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "expr": "topk(10, sum by (method, path, status) (rate(http_requests_total{namespace=\"$namespace\", path=~\"$path\", status=~\"4..|5..\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{path}} ({{status}})"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Request Latency Quantiles (p50 / p95 / p99)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\", path=~\"$path\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\", path=~\"$path\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\", path=~\"$path\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Top 10 Routes by RPS",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "expr": "topk(10, sum by (method, path) (rate(http_requests_total{namespace=\"$namespace\", path=~\"$path\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{path}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Top 10 Slowest Routes (p95)",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, method, path) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\", path=~\"$path\"}[$__rate_interval]))))",
          "legendFormat": "{{method}} {{path}}"
        }
      ]
    }
  ]
}
