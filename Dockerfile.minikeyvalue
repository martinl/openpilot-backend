# syntax=docker/dockerfile:1.7

# =============================================================================
# Stage 1: Build static mkv Go binary
# =============================================================================
FROM golang:1-alpine AS builder

WORKDIR /usr/src/minikeyvalue

COPY minikeyvalue/go.mod minikeyvalue/go.sum ./
RUN go mod download

COPY minikeyvalue/src/ ./src/
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /usr/local/bin/mkv ./src

# =============================================================================
# Stage 2: Minimal non-root nginx volume server + mkv coordinator
# =============================================================================
FROM nginx:stable-alpine AS runtime

RUN apk upgrade --no-cache \
    && addgroup -g 1000 -S mkv \
    && adduser -u 1000 -S -G mkv mkv \
    && mkdir -p /mkv /data /tmp/nginx \
    && chown -R 1000:1000 /mkv /data /tmp/nginx

WORKDIR /mkv

COPY --from=builder --chown=1000:1000 /usr/local/bin/mkv /mkv/mkv
COPY --chmod=755 --chown=1000:1000 deploy/docker/minikeyvalue-entrypoint.sh /mkv/entrypoint.sh

USER 1000:1000

EXPOSE 3000 3001 3002 3003 3004 3005

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["nc", "-z", "127.0.0.1", "3000"]

ENTRYPOINT ["/mkv/entrypoint.sh"]
