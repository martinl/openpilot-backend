# syntax=docker/dockerfile:1.7

# =============================================================================
# Stage 1: Build Connect frontend SPA with Bun (martinl/openpilot-frontend)
# =============================================================================
FROM oven/bun:1-alpine AS builder

WORKDIR /usr/src/frontend

COPY frontend/package.json frontend/bun.lock* ./
RUN bun install --frozen-lockfile || bun install

COPY frontend/ ./

# Build with placeholder tokens replaced at container startup so the exact
# same immutable image can be promoted from test -> prod.
ARG VITE_API_URL="__OPENPILOT_API_HOST__"
ARG VITE_ATHENA_URL="__OPENPILOT_ATHENA_HOST__"
ARG VITE_USERADMIN_URL="__OPENPILOT_USERADMIN_URL__"
ARG VITE_GITHUB_CLIENT_ID="__OPENPILOT_GITHUB_CLIENT_ID__"
ARG VITE_APP_GIT_SHA=""
ARG VITE_APP_GIT_TIMESTAMP=""

RUN bun run build

# =============================================================================
# Stage 2: Stateless non-root Nginx SPA runtime with startup env substitution
# =============================================================================
FROM nginxinc/nginx-unprivileged:stable-alpine AS runtime

USER 0
RUN rm -rf /usr/share/nginx/html/* \
    && chown -R 101:101 /usr/share/nginx/html

COPY --chown=101:101 deploy/docker/frontend-nginx.conf /etc/nginx/conf.d/default.conf
COPY --chmod=755 --chown=101:101 deploy/docker/40-openpilot-runtime-config.sh /docker-entrypoint.d/40-openpilot-runtime-config.sh
COPY --from=builder --chown=101:101 /usr/src/frontend/dist /usr/share/nginx/html

USER 101:101

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/healthz"]
