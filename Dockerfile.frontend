# syntax=docker/dockerfile:1.7

# =============================================================================
# Stage 1: Build Connect frontend SPA with Bun (martinl/openpilot-frontend)
# =============================================================================
FROM oven/bun:1-alpine AS builder

WORKDIR /usr/src/frontend

COPY frontend/package.json frontend/bun.lock* ./
RUN bun install --frozen-lockfile || bun install

COPY frontend/ ./

# Build with placeholder tokens replaced at container startup so the exact
# same immutable image can be promoted from test -> prod.
ARG VITE_API_HOST="__OPENPILOT_API_HOST__"
ARG VITE_ATHENA_HOST="__OPENPILOT_ATHENA_HOST__"
ARG VITE_GITHUB_CLIENT_ID="__OPENPILOT_GITHUB_CLIENT_ID__"
ENV VITE_API_HOST=${VITE_API_HOST}
ENV VITE_ATHENA_HOST=${VITE_ATHENA_HOST}
ENV VITE_GITHUB_CLIENT_ID=${VITE_GITHUB_CLIENT_ID}

RUN bun run build

# =============================================================================
# Stage 2: Stateless Nginx SPA runtime with startup env substitution
# =============================================================================
FROM nginx:stable-alpine AS runtime

COPY deploy/docker/frontend-nginx.conf /etc/nginx/conf.d/default.conf
COPY --chmod=755 deploy/docker/40-openpilot-runtime-config.sh /docker-entrypoint.d/40-openpilot-runtime-config.sh
COPY --from=builder /usr/src/frontend/dist /usr/share/nginx/html

EXPOSE 80
