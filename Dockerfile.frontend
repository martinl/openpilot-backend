# syntax=docker/dockerfile:1.7

# =============================================================================
# Stage 1: Build Connect frontend SPA with Bun (martinl/openpilot-frontend)
# =============================================================================
FROM oven/bun:1-alpine AS builder

WORKDIR /usr/src/frontend

COPY frontend/package.json frontend/bun.lock* ./
RUN bun install --frozen-lockfile || bun install

COPY frontend/ ./

# Build with placeholder tokens replaced at container startup so the exact
# same immutable image can be promoted from test -> prod.
ARG VITE_API_HOST="__OPENPILOT_API_HOST__"
ARG VITE_ATHENA_HOST="__OPENPILOT_ATHENA_HOST__"
ARG VITE_GITHUB_CLIENT_ID="__OPENPILOT_GITHUB_CLIENT_ID__"
ENV VITE_API_HOST=${VITE_API_HOST}
ENV VITE_ATHENA_HOST=${VITE_ATHENA_HOST}
ENV VITE_GITHUB_CLIENT_ID=${VITE_GITHUB_CLIENT_ID}

RUN bun run build

# =============================================================================
# Stage 2: Stateless Nginx SPA runtime with startup env substitution
# =============================================================================
FROM nginx:stable-alpine AS runtime

COPY deploy/docker/frontend-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /usr/src/frontend/dist /usr/share/nginx/html

RUN cat <<'EOF' > /docker-entrypoint.d/40-openpilot-runtime-config.sh
#!/bin/sh
set -eu

API_HOST="${API_ENDPOINT:-https://api.apps.k8s.mlp.ee}"
ATHENA_HOST="${ATHENA_ENDPOINT:-https://athena.apps.k8s.mlp.ee}"
ATHENA_WS_HOST="$(printf '%s' "${ATHENA_HOST}" | sed 's|^https://|wss://|; s|^http://|ws://|')"
GITHUB_CLIENT_ID="${GITHUB_CLIENT:-}"

cat <<JSEOF > /usr/share/nginx/html/config.js
window.__OPENPILOT_CONFIG__ = {
  API_HOST: "${API_HOST}",
  ATHENA_HOST: "${ATHENA_HOST}",
  GITHUB_CLIENT_ID: "${GITHUB_CLIENT_ID}"
};
JSEOF

find /usr/share/nginx/html -type f \( -name '*.js' -o -name '*.html' \) -exec sed -i \
  -e "s|__OPENPILOT_API_HOST__|${API_HOST}|g" \
  -e "s|__OPENPILOT_ATHENA_HOST__|${ATHENA_HOST}|g" \
  -e "s|__OPENPILOT_GITHUB_CLIENT_ID__|${GITHUB_CLIENT_ID}|g" \
  -e "s|https://api\.konik\.ai|${API_HOST}|g" \
  -e "s|https://athena\.konik\.ai|${ATHENA_HOST}|g" \
  -e "s|wss://athena\.konik\.ai|${ATHENA_WS_HOST}|g" \
  {} +
EOF
RUN chmod +x /docker-entrypoint.d/40-openpilot-runtime-config.sh

EXPOSE 80
