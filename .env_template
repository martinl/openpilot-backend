POSTGRES_DB=connect_development
POSTGRES_USER=loco
POSTGRES_PASSWORD=
DATABASE_URL=postgres://loco:loco@localhost:5432/connect_development
DB_MAX_CONNECTIONS=30
REDIS_URL=redis://127.0.0.1:6379
MAILER_HOST=mailer
MAILER_PORT=1025
LOG_LEVEL=info
CONNECT_PORT=3111
USERADMIN_PORT=3112
ENABLE_INTERNAL_TLS=false
# Optional: directory containing cert.pem and key.pem when ENABLE_INTERNAL_TLS=true
TLS_CERT_DIR=
GITHUB_SECRET=
GITHUB_CLIENT=
SERVER_SECRET=
ADMIN_JWT=
MAPBOX_TOKEN=
HF_TOKEN=
HF_HUB_ENABLE_HF_TRANSFER=1
# Optional: force a specific FFmpeg H.264 encoder (e.g. libx264)
FFMPEG_ENCODER=
MOUNT_POINT=/mnt/raid5
MKV_ENDPOINT=http://localhost:3000

# Public endpoints & cookie configuration
API_ENDPOINT=https://api.test.apps.k8s.mlp.ee
# Optional: override only the upload host for `/connectincoming/...` URLs
UPLOAD_ENDPOINT=
# Optional: override frontend API origin returned to clients
FRONTEND_API_ENDPOINT=
WS_ENDPOINT=wss://api.test.apps.k8s.mlp.ee/ws
FRONTEND_URL=https://connect.test.apps.k8s.mlp.ee
USERADMIN_URL=https://useradmin.test.apps.k8s.mlp.ee
USERADMIN_HOST=useradmin.test.apps.k8s.mlp.ee
COOKIE_DOMAIN=.test.apps.k8s.mlp.ee
COOKIE_NAME=jwt_test
